# Model Advisor — Environment Variables
# Copy to .env and adjust as needed

# Server
MODEL_ADVISOR_HOST=0.0.0.0
MODEL_ADVISOR_PORT=8000

# CORS (comma-separated origins)
MODEL_ADVISOR_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API sources
MODEL_ADVISOR_OLLAMA_API_BASE=https://ollama.com/api
MODEL_ADVISOR_HUGGINGFACE_API_BASE=https://huggingface.co/api

# Cache TTL in seconds
MODEL_ADVISOR_CACHE_TTL_SECONDS=300

# Debug mode
MODEL_ADVISOR_DEBUG=false
